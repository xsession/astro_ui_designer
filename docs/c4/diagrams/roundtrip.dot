digraph G { graph [rankdir=LR,bgcolor="white",pad=.4]; node [shape=box,style="rounded,filled",fontname="Arial"]; files [label="Source files",fillcolor="#f5f5f5"]; detect [label="Detect backend",fillcolor="#ffe6cc"]; adapter [label="Adapter",fillcolor="#ffe6cc"]; ir [label="Neutral IR",fillcolor="#d5e8d4"]; model [label="Designer model",fillcolor="#dae8fc"]; plan [label="Reviewed patch plan",fillcolor="#e1d5e7"]; files->detect->adapter->ir->model; model->plan->adapter; adapter->files [label="fingerprinted patch"]; }