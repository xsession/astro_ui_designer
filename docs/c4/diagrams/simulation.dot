digraph G { graph [rankdir=LR,bgcolor="white",pad=.4]; node [shape=box,style="rounded,filled",fontname="Arial"]; start [label="Session",fillcolor="#dae8fc"]; event [label="Event",fillcolor="#d5e8d4"]; cond [label="Restricted condition",fillcolor="#fff2cc"]; action [label="Declarative action",fillcolor="#ffe6cc"]; state [label="State / route / overlays",fillcolor="#d5e8d4"]; view [label="UI/MCP summary",fillcolor="#e1d5e7"]; start->state; event->cond->action->state->view; view->event; }