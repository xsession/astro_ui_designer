---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Contact" description="Contact form" canonical="" ogImage="">
  <main class="ui-page-t8srmqe-14" data-ui-id="page-t8srmqe-14">
    <section class="ui-section-t8srmqe-15" data-ui-id="section-t8srmqe-15" data-ui-state="default">
      <div class="ui-container-t8srmqe-16" data-ui-id="container-t8srmqe-16" data-ui-state="default">
        <form class="ui-form-t8srmqf-17" data-ui-id="form-t8srmqf-17" data-ui-state="default" method="post">
          <h1 class="ui-heading-t8srmqf-18" data-ui-id="heading-t8srmqf-18" data-ui-state="default">Contact</h1>
          <label class="ui-label-t8srmqf-19" data-ui-id="label-t8srmqf-19" data-ui-state="default" for="email">Email</label>
          <input class="ui-input-t8srmqf-1a" data-ui-id="input-t8srmqf-1a" data-ui-state="default" type="email" name="email" placeholder="you@example.com" required />
          <label class="ui-label-t8srmqf-1b" data-ui-id="label-t8srmqf-1b" data-ui-state="default" for="message">Message</label>
          <textarea class="ui-textarea-t8srmqf-1c" data-ui-id="textarea-t8srmqf-1c" data-ui-state="default" name="message" placeholder="How can we help?" rows="5" required></textarea>
          <button class="ui-button-t8srmqf-1d" data-ui-id="button-t8srmqf-1d" data-ui-state="default" type="submit">Send</button>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
