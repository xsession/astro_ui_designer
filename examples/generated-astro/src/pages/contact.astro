---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Contact" description="Contact form" canonical="" ogImage="">
  <main class="ui-page-tg29bz7-14" data-ui-id="page-tg29bz7-14">
    <section class="ui-section-tg29bz7-15" data-ui-id="section-tg29bz7-15" data-ui-state="default">
      <div class="ui-container-tg29bz7-16" data-ui-id="container-tg29bz7-16" data-ui-state="default">
        <form class="ui-form-tg29bz8-17" data-ui-id="form-tg29bz8-17" data-ui-state="default" method="post">
          <h1 class="ui-heading-tg29bz8-18" data-ui-id="heading-tg29bz8-18" data-ui-state="default">Contact</h1>
          <label class="ui-label-tg29bz8-19" data-ui-id="label-tg29bz8-19" data-ui-state="default" for="email">Email</label>
          <input class="ui-input-tg29bz8-1a" data-ui-id="input-tg29bz8-1a" data-ui-state="default" type="email" name="email" placeholder="you@example.com" required />
          <label class="ui-label-tg29bz8-1b" data-ui-id="label-tg29bz8-1b" data-ui-state="default" for="message">Message</label>
          <textarea class="ui-textarea-tg29bz8-1c" data-ui-id="textarea-tg29bz8-1c" data-ui-state="default" name="message" placeholder="How can we help?" rows="5" required></textarea>
          <button class="ui-button-tg29bz8-1d" data-ui-id="button-tg29bz8-1d" data-ui-state="default" type="submit">Send</button>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
