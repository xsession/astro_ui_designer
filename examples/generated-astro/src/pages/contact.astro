---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Contact" description="Contact form" canonical="" ogImage="">
  <main class="ui-page-th4ru20-14" data-ui-id="page-th4ru20-14">
    <section class="ui-section-th4ru20-15" data-ui-id="section-th4ru20-15" data-ui-state="default">
      <div class="ui-container-th4ru20-16" data-ui-id="container-th4ru20-16" data-ui-state="default">
        <form class="ui-form-th4ru20-17" data-ui-id="form-th4ru20-17" data-ui-state="default" method="post">
          <h1 class="ui-heading-th4ru20-18" data-ui-id="heading-th4ru20-18" data-ui-state="default">Contact</h1>
          <label class="ui-label-th4ru20-19" data-ui-id="label-th4ru20-19" data-ui-state="default" for="email">Email</label>
          <input class="ui-input-th4ru20-1a" data-ui-id="input-th4ru20-1a" data-ui-state="default" type="email" name="email" placeholder="you@example.com" required />
          <label class="ui-label-th4ru21-1b" data-ui-id="label-th4ru21-1b" data-ui-state="default" for="message">Message</label>
          <textarea class="ui-textarea-th4ru21-1c" data-ui-id="textarea-th4ru21-1c" data-ui-state="default" name="message" placeholder="How can we help?" rows="5" required></textarea>
          <button class="ui-button-th4ru21-1d" data-ui-id="button-th4ru21-1d" data-ui-state="default" type="submit">Send</button>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
