---
const title="Contact";
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{title}</title><style is:global>
[data-ui-id="page-ts645aq-14"] {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
}

[data-ui-id="section-ts645aq-15"] {
  width: 100%;
  padding: 48px 24px;
}

@media (max-width: 960px) {
[data-ui-id="section-ts645aq-15"] {
  padding: 36px 20px;
}
}

@media (max-width: 640px) {
[data-ui-id="section-ts645aq-15"] {
  padding: 28px 16px;
}
}

[data-ui-id="container-ts645aq-16"] {
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
}

[data-ui-id="form-ts645aq-17"] {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

[data-ui-id="heading-ts645as-18"] {
  margin: 0;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 700;
}

@media (max-width: 960px) {
[data-ui-id="heading-ts645as-18"] {
  font-size: 28px;
}
}

@media (max-width: 640px) {
[data-ui-id="heading-ts645as-18"] {
  font-size: 24px;
}
}

[data-ui-id="label-ts645as-19"] {
  display: block;
  font-weight: 600;
  margin-bottom: 4px;
}

[data-ui-id="input-ts645as-1a"] {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  color: var(--color-text);
}

[data-ui-id="label-ts645as-1b"] {
  display: block;
  font-weight: 600;
  margin-bottom: 4px;
}

[data-ui-id="textarea-ts645as-1c"] {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  resize: vertical;
}

[data-ui-id="button-ts645as-1d"] {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 16px;
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
  cursor: pointer;
}

@media (max-width: 640px) {
[data-ui-id="button-ts645as-1d"] {
  width: 100%;
}
}
</style></head><body>
  <main data-ui-id="page-ts645aq-14">
    <section data-ui-id="section-ts645aq-15">
      <div data-ui-id="container-ts645aq-16">
        <form data-ui-id="form-ts645aq-17">
          <h1 data-ui-id="heading-ts645as-18">
Contact
          </h1>
          <label data-ui-id="label-ts645as-19">
Email
          </label>
          <input data-ui-id="input-ts645as-1a" type="email" name="email" placeholder="you@example.com" />
          <label data-ui-id="label-ts645as-1b">
Message
          </label>
          <textarea data-ui-id="textarea-ts645as-1c"></textarea>
          <button data-ui-id="button-ts645as-1d" type="submit">
Send
          </button>
        </form>
      </div>
    </section>
  </main>
</body></html>
