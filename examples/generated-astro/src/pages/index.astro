---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import InfoPanel from '../components/InfoPanel.astro';
---

<BaseLayout title="Home" description="Generated with Astro UI Designer Pro" canonical="" ogImage="">
  <main class="ui-page-t8srmqd-1" data-ui-id="page-t8srmqd-1">
    <header class="ui-header-t8srmqd-6" data-ui-id="header-t8srmqd-6" data-ui-state="default">
      <nav class="ui-nav-t8srmqd-7" data-ui-id="nav-t8srmqd-7" data-ui-state="default" aria-label="Main navigation">
        <h3 class="ui-heading-t8srmqe-8" data-ui-id="heading-t8srmqe-8" data-ui-state="default">Astro UI Designer</h3>
        <div class="ui-row-t8srmqe-9" data-ui-id="row-t8srmqe-9" data-ui-state="default">
          <a class="ui-link-t8srmqe-a" data-ui-id="link-t8srmqe-a" data-ui-state="default" href="#features">Features</a>
          <a class="ui-link-t8srmqe-b" data-ui-id="link-t8srmqe-b" data-ui-state="default" href="/contact">Contact</a>
        </div>
      </nav>
    </header>
    <section class="ui-section-t8srmqe-c" data-ui-id="section-t8srmqe-c" data-ui-state="default">
      <div class="ui-container-t8srmqe-d" data-ui-id="container-t8srmqe-d" data-ui-state="default">
        <div class="ui-row-t8srmqe-e" data-ui-id="row-t8srmqe-e" data-ui-state="default">
          <div class="ui-column-t8srmqe-f" data-ui-id="column-t8srmqe-f" data-ui-state="default">
            <span class="ui-badge-t8srmqe-g" data-ui-id="badge-t8srmqe-g" data-ui-state="default">Visual Astro IDE</span>
            <h1 class="ui-heading-t8srmqe-h" data-ui-id="heading-t8srmqe-h" data-ui-state="default">Build responsive Astro interfaces visually.</h1>
            <p class="ui-text-t8srmqe-i" data-ui-id="text-t8srmqe-i" data-ui-state="default">Qt Creator-style workflow, web-native layout rules, reusable components, responsive states, actions, assets and clean Astro output.</p>
            <div class="ui-row-t8srmqe-j" data-ui-id="row-t8srmqe-j" data-ui-state="default">
              <button class="ui-button-t8srmqe-l" data-ui-id="button-t8srmqe-l" data-ui-state="default" data-ui-actions="[{&quot;event&quot;:&quot;click&quot;,&quot;type&quot;:&quot;navigate&quot;,&quot;value&quot;:&quot;/docs&quot;,&quot;target&quot;:&quot;&quot;,&quot;condition&quot;:&quot;&quot;}]" type="button">Open docs</button>
              <a class="ui-link-t8srmqe-m" data-ui-id="link-t8srmqe-m" data-ui-state="default" href="#features">See features</a>
            </div>
          </div>
          <article class="ui-card-t8srmqe-n" data-ui-id="card-t8srmqe-n" data-ui-state="default">
            <h3 class="ui-heading-t8srmqe-o" data-ui-id="heading-t8srmqe-o" data-ui-state="default">Source-first output</h3>
            <p class="ui-text-t8srmqe-p" data-ui-id="text-t8srmqe-p" data-ui-state="default">Generated pages, components, layouts, CSS, assets and client actions stay readable and editable.</p>
          </article>
        </div>
      </div>
    </section>
    <section class="ui-section-t8srmqe-q" data-ui-id="section-t8srmqe-q" data-ui-state="default" aria-label="Features">
      <div class="ui-container-t8srmqe-r" data-ui-id="container-t8srmqe-r" data-ui-state="default">
        <h2 class="ui-heading-t8srmqe-s" data-ui-id="heading-t8srmqe-s" data-ui-state="default">A full visual frontend IDE</h2>
        <div class="ui-spacer-t8srmqe-13" data-ui-id="spacer-t8srmqe-13" data-ui-state="default"></div>
        <div class="ui-grid-t8srmqe-t" data-ui-id="grid-t8srmqe-t" data-ui-state="default">
          <article class="ui-card-t8srmqe-u" data-ui-id="card-t8srmqe-u" data-ui-state="default">
            <h3 class="ui-heading-t8srmqe-v" data-ui-id="heading-t8srmqe-v" data-ui-state="default">Responsive layout</h3>
            <p class="ui-text-t8srmqe-w" data-ui-id="text-t8srmqe-w" data-ui-state="default">Flex, Grid, breakpoints and freeform HMI layers.</p>
          </article>
          <article class="ui-card-t8srmqe-x" data-ui-id="card-t8srmqe-x" data-ui-state="default">
            <h3 class="ui-heading-t8srmqe-y" data-ui-id="heading-t8srmqe-y" data-ui-state="default">Reusable components</h3>
            <p class="ui-text-t8srmqe-z" data-ui-id="text-t8srmqe-z" data-ui-state="default">Create project components with slots and instance overrides.</p>
          </article>
          <article class="ui-card-t8srmqe-10" data-ui-id="card-t8srmqe-10" data-ui-state="default">
            <h3 class="ui-heading-t8srmqe-11" data-ui-id="heading-t8srmqe-11" data-ui-state="default">Behavior</h3>
            <p class="ui-text-t8srmqe-12" data-ui-id="text-t8srmqe-12" data-ui-state="default">State variables, bindings and web-native signal/action connections.</p>
          </article>
        </div>
      </div>
    </section>
    <div class="ui-componentInstance-t8srmqf-1i" data-ui-id="componentInstance-t8srmqf-1i" data-ui-state="default" data-ui-timeline="ui-animation-componentInstance-t8srmqf-1i" data-ui-timeline-duration="520" data-ui-animation-engine="css" data-ui-animation-trigger="hover">
      <InfoPanel title={"Reusable component"}>
      <p class="ui-text-t8srmqf-1j" data-ui-id="text-t8srmqf-1j" data-ui-state="default">This content is passed through the default Astro slot.</p>
      </InfoPanel>
    </div>
    <button class="ui-button-t8srmqf-1q" data-ui-id="button-t8srmqf-1q" data-ui-state="default" data-ui-timeline="ui-animation-button-t8srmqf-1q" data-ui-timeline-duration="420" data-ui-animation-engine="waapi" data-ui-animation-trigger="click" data-ui-animation-id="button-t8srmqf-1q" type="button">Animate with JavaScript</button>
  </main>
  <script>import '../scripts/ui-runtime.ts';</script>
</BaseLayout>
