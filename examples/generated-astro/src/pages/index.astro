---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import InfoPanel from '../components/InfoPanel.astro';
---

<BaseLayout title="Home" description="Generated with Astro UI Designer Pro" canonical="" ogImage="">
  <main class="ui-page-th4ru1x-1" data-ui-id="page-th4ru1x-1">
    <header class="ui-header-th4ru1y-6" data-ui-id="header-th4ru1y-6" data-ui-state="default">
      <nav class="ui-nav-th4ru1y-7" data-ui-id="nav-th4ru1y-7" data-ui-state="default" aria-label="Main navigation">
        <h3 class="ui-heading-th4ru1y-8" data-ui-id="heading-th4ru1y-8" data-ui-state="default">Astro UI Designer</h3>
        <div class="ui-row-th4ru1y-9" data-ui-id="row-th4ru1y-9" data-ui-state="default">
          <a class="ui-link-th4ru1y-a" data-ui-id="link-th4ru1y-a" data-ui-state="default" href="#features">Features</a>
          <a class="ui-link-th4ru1y-b" data-ui-id="link-th4ru1y-b" data-ui-state="default" href="/contact">Contact</a>
        </div>
      </nav>
    </header>
    <section class="ui-section-th4ru1y-c" data-ui-id="section-th4ru1y-c" data-ui-state="default">
      <div class="ui-container-th4ru1y-d" data-ui-id="container-th4ru1y-d" data-ui-state="default">
        <div class="ui-row-th4ru1z-e" data-ui-id="row-th4ru1z-e" data-ui-state="default">
          <div class="ui-column-th4ru1z-f" data-ui-id="column-th4ru1z-f" data-ui-state="default">
            <span class="ui-badge-th4ru1z-g" data-ui-id="badge-th4ru1z-g" data-ui-state="default">Visual Astro IDE</span>
            <h1 class="ui-heading-th4ru1z-h" data-ui-id="heading-th4ru1z-h" data-ui-state="default">Build responsive Astro interfaces visually.</h1>
            <p class="ui-text-th4ru1z-i" data-ui-id="text-th4ru1z-i" data-ui-state="default">Qt Creator-style workflow, web-native layout rules, reusable components, responsive states, actions, assets and clean Astro output.</p>
            <div class="ui-row-th4ru1z-j" data-ui-id="row-th4ru1z-j" data-ui-state="default">
              <button class="ui-button-th4ru1z-l" data-ui-id="button-th4ru1z-l" data-ui-state="default" data-ui-actions="[{&quot;event&quot;:&quot;click&quot;,&quot;type&quot;:&quot;navigate&quot;,&quot;value&quot;:&quot;/docs&quot;,&quot;target&quot;:&quot;&quot;,&quot;condition&quot;:&quot;&quot;}]" type="button">Open docs</button>
              <a class="ui-link-th4ru1z-m" data-ui-id="link-th4ru1z-m" data-ui-state="default" href="#features">See features</a>
            </div>
          </div>
          <article class="ui-card-th4ru1z-n" data-ui-id="card-th4ru1z-n" data-ui-state="default">
            <h3 class="ui-heading-th4ru1z-o" data-ui-id="heading-th4ru1z-o" data-ui-state="default">Source-first output</h3>
            <p class="ui-text-th4ru1z-p" data-ui-id="text-th4ru1z-p" data-ui-state="default">Generated pages, components, layouts, CSS, assets and client actions stay readable and editable.</p>
          </article>
        </div>
      </div>
    </section>
    <section class="ui-section-th4ru1z-q" data-ui-id="section-th4ru1z-q" data-ui-state="default" aria-label="Features">
      <div class="ui-container-th4ru1z-r" data-ui-id="container-th4ru1z-r" data-ui-state="default">
        <h2 class="ui-heading-th4ru1z-s" data-ui-id="heading-th4ru1z-s" data-ui-state="default">A full visual frontend IDE</h2>
        <div class="ui-spacer-th4ru20-13" data-ui-id="spacer-th4ru20-13" data-ui-state="default"></div>
        <div class="ui-grid-th4ru1z-t" data-ui-id="grid-th4ru1z-t" data-ui-state="default">
          <article class="ui-card-th4ru20-u" data-ui-id="card-th4ru20-u" data-ui-state="default">
            <h3 class="ui-heading-th4ru20-v" data-ui-id="heading-th4ru20-v" data-ui-state="default">Responsive layout</h3>
            <p class="ui-text-th4ru20-w" data-ui-id="text-th4ru20-w" data-ui-state="default">Flex, Grid, breakpoints and freeform HMI layers.</p>
          </article>
          <article class="ui-card-th4ru20-x" data-ui-id="card-th4ru20-x" data-ui-state="default">
            <h3 class="ui-heading-th4ru20-y" data-ui-id="heading-th4ru20-y" data-ui-state="default">Reusable components</h3>
            <p class="ui-text-th4ru20-z" data-ui-id="text-th4ru20-z" data-ui-state="default">Create project components with slots and instance overrides.</p>
          </article>
          <article class="ui-card-th4ru20-10" data-ui-id="card-th4ru20-10" data-ui-state="default">
            <h3 class="ui-heading-th4ru20-11" data-ui-id="heading-th4ru20-11" data-ui-state="default">Behavior</h3>
            <p class="ui-text-th4ru20-12" data-ui-id="text-th4ru20-12" data-ui-state="default">State variables, bindings and web-native signal/action connections.</p>
          </article>
        </div>
      </div>
    </section>
    <div class="ui-componentInstance-th4ru22-1m" data-ui-id="componentInstance-th4ru22-1m" data-ui-state="default" data-ui-timeline="ui-animation-componentInstance-th4ru22-1m" data-ui-timeline-duration="520" data-ui-animation-engine="css" data-ui-animation-trigger="hover">
      <InfoPanel title={"Reusable component"}>
      <p class="ui-text-th4ru22-1n" data-ui-id="text-th4ru22-1n" data-ui-state="default">This content is passed through the default Astro slot.</p>
      </InfoPanel>
    </div>
    <button class="ui-button-th4ru22-1u" data-ui-id="button-th4ru22-1u" data-ui-state="default" data-ui-timeline="ui-animation-button-th4ru22-1u" data-ui-timeline-duration="420" data-ui-animation-engine="waapi" data-ui-animation-trigger="click" data-ui-animation-id="button-th4ru22-1u" type="button">Animate with JavaScript</button>
  </main>
  <script>import '../scripts/ui-runtime.ts';</script>
</BaseLayout>
