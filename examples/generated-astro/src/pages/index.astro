---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import InfoPanel from '../components/InfoPanel.astro';
---

<BaseLayout title="Home" description="Generated with Astro UI Designer Pro" canonical="" ogImage="">
  <main class="ui-page-tg29bz6-1" data-ui-id="page-tg29bz6-1">
    <header class="ui-header-tg29bz7-6" data-ui-id="header-tg29bz7-6" data-ui-state="default">
      <nav class="ui-nav-tg29bz7-7" data-ui-id="nav-tg29bz7-7" data-ui-state="default" aria-label="Main navigation">
        <h3 class="ui-heading-tg29bz7-8" data-ui-id="heading-tg29bz7-8" data-ui-state="default">Astro UI Designer</h3>
        <div class="ui-row-tg29bz7-9" data-ui-id="row-tg29bz7-9" data-ui-state="default">
          <a class="ui-link-tg29bz7-a" data-ui-id="link-tg29bz7-a" data-ui-state="default" href="#features">Features</a>
          <a class="ui-link-tg29bz7-b" data-ui-id="link-tg29bz7-b" data-ui-state="default" href="/contact">Contact</a>
        </div>
      </nav>
    </header>
    <section class="ui-section-tg29bz7-c" data-ui-id="section-tg29bz7-c" data-ui-state="default">
