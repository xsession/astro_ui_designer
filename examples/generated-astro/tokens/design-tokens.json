{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#f6f8fb"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "text": {
      "$type": "color",
      "$value": "#17202a"
    },
    "muted": {
      "$type": "color",
      "$value": "#e8edf3"
    },
    "border": {
      "$type": "color",
      "$value": "#d7dce2"
    },
    "primary": {
      "$type": "color",
      "$value": "#2f6fa7"
    },
    "accent": {
      "$type": "color",
      "$value": "#7c3aed"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "sm": {
      "$type": "string",
      "$value": "0 2px 8px rgba(16,24,40,.06)"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "6": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  }
}
