{
  "name": "astro-ui-designer-vscode",
  "displayName": "Astro UI Designer 2.16",
  "version": "2.16.0",
  "publisher": "xsession",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:astroUIDesigner.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "astroUIDesigner.open",
        "title": "Astro UI Designer: Open Designer"
      },
      {
        "command": "astroUIDesigner.openFile",
        "title": "Astro UI Designer: Open Current Astro File"
      }
    ],
    "configuration": {
      "title": "Astro UI Designer",
      "properties": {
        "astroUIDesigner.previewCommand": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run-tests.mjs"
  },
  "description": "Visual Astro IDE with functional relocatable workbenches, editable hotkeys, page entity management, Draw.io interchange and round-trip source editing"
}
